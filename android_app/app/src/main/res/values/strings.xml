    <string name="app_name">象棋助手</string>

    <string name="title">象棋悬浮窗助手</string>
    <string name="subtitle">自动读取棋局 · 实时给出建议 · 落子由你完成</string>

    <string name="card_permission">① 先开权限</string>
    <string name="perm_overlay">悬浮窗权限</string>
    <string name="perm_overlay_desc">必须开启，否则提示无法显示在象棋 App 上层</string>
    <string name="perm_notification">通知权限</string>
    <string name="perm_notification_desc">用于显示常驻通知与状态</string>
    <string name="perm_battery">后台运行白名单</string>
    <string name="perm_battery_desc">必须设为「无限制」，否则切到象棋 App 后会被系统杀掉</string>
    <string name="action_grant">去开启</string>
    <string name="action_granted">已开启</string>
    <string name="action_skip">可跳过</string>

    <string name="card_setup">② 标定棋盘</string>
    <string name="setup_hint">标定在悬浮窗上完成：先在象棋 App 里打开一盘棋、让棋盘完整显示两三秒，然后点悬浮窗面板上的「标定」按钮，在弹出的全屏标定层里拖动四个角点框住棋盘。每个象棋 App 只需标定一次。</string>
    <string name="action_calibrate">标定棋盘四角</string>

