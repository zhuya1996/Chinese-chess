<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <com.xiangqi.overlay.CalibrationView
        android:id="@+id/calibView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC000000"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvCalibInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calib_instruction"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/calib_zoom_hint"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="10dp"
        android:background="#CC000000"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvCalibStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFCC80"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSide"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/calib_bottom_red"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnRecapture"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/calib_recapture"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnConfirmCalib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/calib_confirm"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
